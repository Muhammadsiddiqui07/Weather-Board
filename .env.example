# WeatherBoard Environment Variables
# Copy this file to .env and provide your API keys

# OpenWeatherMap API Key (Get free key from https://openweathermap.org/api)
VITE_OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# RapidAPI Key for GeoDB Cities API (Get from https://rapidapi.com/wirefreethought/api/geodb-cities)
VITE_RAPID_API_KEY=your_rapidapi_key_here

# Note: Open-Meteo does not require an API key and acts as an automatic fallback.
